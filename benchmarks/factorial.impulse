module benchmark::factorial;

// Benchmark: Factorial of 21
// Expected result: 51090942171709440000
// Demonstrates: recursive function calls, stack management, handling of large numbers
// Note: 21! = 51090942171709440000 overflows int64 (max 9223372036854775807)

func factorial(n: int) -> int {
    if n <= 1 {
        return 1;
    }
    return n * factorial(n - 1);
}

func main() -> int {
    // Calculate and return factorial of 21
    // 21! = 51090942171709440000 (fits in int64)
    let fact: int = factorial(21);
    print("factorial(21) = ");
    println(fact);
    return fact;
}
